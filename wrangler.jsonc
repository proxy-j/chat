{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chet",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ChatRoom"]
    }
  ]
}
